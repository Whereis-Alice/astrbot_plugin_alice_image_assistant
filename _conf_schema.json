{
  "find_image": {
    "type": "object",
    "description": "找图模块",
    "hint": "文字找图、Pixiv、自动选源、失败回退和 LLM 视觉审核。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用找图模块",
        "default": true
      },
      "commands_enabled": {
        "type": "bool",
        "description": "启用找图与 Pixiv 指令",
        "default": true
      },
      "llm_tools_enabled": {
        "type": "bool",
        "description": "启用找图 LLM 工具",
        "hint": "关闭后不会向模型暴露 alice_image_find 和 Pixiv 小说工具。",
        "default": true
      },
      "inject_tool_guidance_enabled": {
        "type": "bool",
        "description": "向模型注入图片工具使用提示",
        "default": true
      },
      "auto_illustration_enabled": {
        "type": "bool",
        "description": "允许 Bot 主动为介绍内容配图",
        "hint": "仅在配图能明显帮助理解时使用；用户明确找图不受此项影响。",
        "default": true
      },
      "llm_search_progress_message_enabled": {
        "type": "bool",
        "description": "LLM 自主找图前发送“正在为你寻找...”提示",
        "hint": "关闭后 Bot 通过 LLM 工具找图时不再额外发送前置提示，只发送最终图片或失败结果。",
        "default": false
      },
      "tool_send_images": {
        "type": "bool",
        "description": "LLM 工具直接向用户发送图片",
        "hint": "关闭后工具只返回结果信息；指令仍会发图。",
        "default": true
      },
      "tool_send_wait_timeout_seconds": {
        "type": "int",
        "description": "LLM 工具等待平台发送确认的秒数",
        "hint": "超过后工具先返回，图片发送留在后台继续；设为 0 表示一直等待平台发送结束。",
        "default": 45,
        "slider": {"min": 0, "max": 180, "step": 5}
      },
      "auto_source_enabled": {
        "type": "bool",
        "description": "允许 auto 根据内容自动选源",
        "default": true
      },
      "default_source": {
        "type": "string",
        "description": "关闭自动选源后的默认来源",
        "options": ["pixiv", "soutu", "serpapi"],
        "default": "soutu"
      },
      "fallback_enabled": {
        "type": "bool",
        "description": "来源失败时自动回退",
        "default": true
      },
      "fallback_order": {
        "type": "list",
        "description": "找图来源回退顺序",
        "hint": "可用值：pixiv、soutu、serpapi；重复或未知值会被忽略。",
        "default": ["soutu", "serpapi", "pixiv"]
      },
      "llm_review": {
        "type": "object",
        "description": "LLM 视觉审核",
        "hint": "让视觉模型比较候选图并挑选最符合描述的结果。",
        "items": {
          "enabled": {
            "type": "bool",
            "description": "启用视觉审核挑图",
            "default": true
          },
          "commands_enabled": {
            "type": "bool",
            "description": "指令找图也使用视觉审核",
            "default": true
          },
          "provider_id": {
            "type": "string",
            "description": "审核模型",
            "hint": "留空使用当前会话模型；开启“当前会话 Bot 筛图”时还会继承当前人格与近期对话。模型必须支持图片输入。",
            "_special": "select_provider",
            "default": ""
          },
          "current_session_bot_enabled": {
            "type": "bool",
            "description": "当前会话 Bot 筛图",
            "hint": "审核模型留空时，由当前会话模型结合当前人格和近期对话理解用户意图。筛图请求不带任何工具，不会递归调用找图。",
            "default": true
          },
          "current_session_context_turns": {
            "type": "int",
            "description": "筛图继承的近期对话轮数",
            "hint": "只用于理解指代和偏好，不会改写会话历史；设为 0 时仅继承当前人格。",
            "default": 4,
            "slider": {"min": 0, "max": 20, "step": 1}
          },
          "fail_open": {
            "type": "bool",
            "description": "审核不可用时放行首选结果",
            "hint": "关闭后审核模型失败会让该来源失败，并触发来源回退。",
            "default": true
          },
          "strict_match_enabled": {
            "type": "bool",
            "description": "明确无匹配时拒绝发送候选图",
            "hint": "默认开启。视觉模型明确判断全部候选不匹配时，不发送首图并尝试下一来源；关闭会允许发送未匹配的首图。",
            "default": true
          },
          "final_verify_enabled": {
            "type": "bool",
            "description": "终选单图全分辨率复核",
            "hint": "默认开启。拼图阶段每格只有 300x300，细节几乎全丢；开启后会把拼图选中的那一张按接近原分辨率再送一次视觉模型逐条核对描述，是精准度提升最大的一环，代价是每次找图多一次模型调用。",
            "default": true
          },
          "confidence_threshold": {
            "type": "float",
            "description": "终选置信度阈值",
            "hint": "视觉模型自评置信度低于该值的候选会被剔除并重选。调高更精准但更容易“找不到图”，调低更容易出图但可能不够贴描述。",
            "default": 0.6,
            "slider": {"min": 0, "max": 1, "step": 0.05}
          },
          "final_verify_max_edge": {
            "type": "int",
            "description": "复核图最长边像素",
            "hint": "复核前把候选图缩到该最长边再上传。调大看得更清但上传体积和推理成本上升。",
            "default": 1280,
            "slider": {"min": 640, "max": 2048, "step": 64}
          },
          "final_verify_retry_limit": {
            "type": "int",
            "description": "复核被拒后最多重选次数",
            "hint": "候选被复核判为不符时最多再换几张重试，0 表示拒绝即放弃该来源并回退到下一来源。",
            "default": 2,
            "slider": {"min": 0, "max": 5, "step": 1}
          },
          "candidate_count": {
            "type": "int",
            "description": "Pixiv 审核候选数",
            "default": 12,
            "slider": {"min": 2, "max": 24, "step": 1}
          },
          "pixiv_search_pages": {
            "type": "int",
            "description": "Pixiv 精确找图抓取页数",
            "default": 5,
            "slider": {"min": 1, "max": 20, "step": 1}
          },
          "max_concurrency": {
            "type": "int",
            "description": "视觉审核最大并发数",
            "default": 2,
            "slider": {"min": 1, "max": 8, "step": 1}
          }
        }
      },
      "pixiv": {
        "type": "object",
        "description": "Pixiv 找图",
        "items": {
          "enabled": {
            "type": "bool",
            "description": "启用 Pixiv 模块",
            "default": true
          },
          "features": {
            "type": "object",
            "description": "Pixiv 功能开关",
            "items": {
              "llm_search": {"type": "bool", "description": "LLM Pixiv 精确找图", "default": true},
              "novel_tool": {"type": "bool", "description": "Pixiv 小说 LLM 工具", "default": true},
              "illust_search": {"type": "bool", "description": "标签搜索插画", "default": true},
              "illust_new": {"type": "bool", "description": "最新插画", "default": true},
              "illust_recommended": {"type": "bool", "description": "推荐插画", "default": true},
              "illust_and": {"type": "bool", "description": "AND 多标签搜索", "default": true},
              "url_lookup": {"type": "bool", "description": "自动解析 Pixiv 作品链接", "default": true},
              "illust_detail": {"type": "bool", "description": "作品 ID 详情", "default": true},
              "ranking": {"type": "bool", "description": "排行榜", "default": true},
              "related": {"type": "bool", "description": "相关作品", "default": true},
              "deep_search": {"type": "bool", "description": "深度搜索", "default": true},
              "illust_comments": {"type": "bool", "description": "插画评论", "default": true},
              "showcase": {"type": "bool", "description": "特辑详情", "default": true},
              "user_search": {"type": "bool", "description": "画师搜索", "default": true},
              "user_detail": {"type": "bool", "description": "画师详情", "default": true},
              "user_illusts": {"type": "bool", "description": "画师作品", "default": true},
              "artist_random": {"type": "bool", "description": "指定画师随机作品", "default": true},
              "artist_search": {"type": "bool", "description": "指定画师精确找图", "default": true},
              "novel_search": {"type": "bool", "description": "小说搜索", "default": true},
              "novel_recommended": {"type": "bool", "description": "推荐小说", "default": true},
              "novel_new": {"type": "bool", "description": "最新小说", "default": true},
              "novel_series": {"type": "bool", "description": "小说系列", "default": true},
              "novel_comments": {"type": "bool", "description": "小说评论", "default": true},
              "novel_download": {"type": "bool", "description": "小说 PDF 下载", "default": true},
              "subscriptions": {"type": "bool", "description": "画师订阅与定时推送", "default": true},
              "random_search": {"type": "bool", "description": "随机标签搜索", "default": true},
              "random_ranking": {"type": "bool", "description": "随机排行榜", "default": true},
              "trending_tags": {"type": "bool", "description": "趋势标签", "default": true},
              "ai_display_setting": {"type": "bool", "description": "会话内 AI 作品显示设置", "default": true},
              "runtime_config": {"type": "bool", "description": "指令修改 Pixiv 配置", "default": true},
              "hot_search": {"type": "bool", "description": "按热度搜索", "default": true},
              "fanbox_creator": {"type": "bool", "description": "Fanbox 创作者", "default": true},
              "fanbox_post": {"type": "bool", "description": "Fanbox 帖子", "default": true},
              "fanbox_recommended": {"type": "bool", "description": "Fanbox 推荐", "default": true},
              "fanbox_artist": {"type": "bool", "description": "Fanbox 画师搜索", "default": true},
              "help": {"type": "bool", "description": "Pixiv 帮助指令", "default": true}
            }
          },
          "settings": {
            "type": "object",
            "description": "Pixiv 参数",
            "items": {
              "refresh_token": {
                "type": "string",
                "description": "Pixiv Refresh Token",
                "hint": "Pixiv API 认证必需。",
                "is_sensitive": true,
                "default": ""
              },
              "fanbox_sessid": {"type": "string", "description": "Fanbox FANBOXSESSID", "is_sensitive": true, "default": ""},
              "fanbox_cookie": {"type": "string", "description": "Fanbox 完整 Cookie", "is_sensitive": true, "default": ""},
              "fanbox_user_agent": {"type": "string", "description": "Fanbox User-Agent", "default": ""},
              "fanbox_data_source": {"type": "string", "description": "Fanbox 数据源", "options": ["auto", "official", "nekohouse"], "default": "auto"},
              "return_count": {"type": "int", "description": "指令默认返回作品数", "default": 1, "slider": {"min": 1, "max": 10, "step": 1}},
              "randomize_search_results": {
                "type": "bool",
                "description": "随机抽取 Pixiv 搜索结果",
                "hint": "默认开启。除作品 ID 和链接直取外，多候选搜索会先打散作品池；启用 LLM 审核时仍会从随机候选中挑选最符合描述的作品。",
                "default": true
              },
              "recent_dedup_enabled": {
                "type": "bool",
                "description": "避免近期重复发送同一 Pixiv 作品",
                "hint": "按群聊或私聊分别记录。候选全部发过时会自动允许复用旧作品，避免无图可发。",
                "default": true
              },
              "recent_dedup_retention_days": {
                "type": "int",
                "description": "近期作品去重保留天数",
                "default": 7,
                "slider": {"min": 1, "max": 90, "step": 1}
              },
              "artist_random_blocked_tags": {
                "type": "list",
                "description": "画师随机作品屏蔽标签",
                "hint": "仅作用于 /aaP画师随。精确匹配 Pixiv 原始标签或翻译标签，不区分大小写。",
                "default": []
              },
              "artist_random_pages": {
                "type": "int",
                "description": "画师随机作品池抓取页数",
                "hint": "页数越多，随机范围越广，但请求时间也会增加。",
                "default": 3,
                "slider": {"min": 1, "max": 10, "step": 1}
              },
              "r18_mode": {"type": "string", "description": "R18 过滤模式", "options": ["过滤 R18", "允许 R18", "仅 R18"], "default": "过滤 R18"},
              "filter_r18g_only": {"type": "bool", "description": "额外过滤 R18G", "default": false},
              "ai_filter_mode": {"type": "string", "description": "AI 作品过滤", "options": ["显示 AI 作品", "过滤 AI 作品", "仅 AI 作品"], "default": "显示 AI 作品"},
              "ai_detection_mode": {"type": "string", "description": "AI 判定方式", "options": ["field_or_tag", "field_only", "tag_only"], "default": "field_or_tag"},
              "min_bookmarks": {"type": "int", "description": "最小收藏数，0 关闭", "hint": "配合「搜索默认按热度排序」才是真正的质量闸门；想明显提升观感建议设到 300 左右。", "default": 0},
              "min_views": {"type": "int", "description": "最小浏览数，0 关闭", "default": 0},
              "min_likes": {"type": "int", "description": "最小点赞数，0 关闭", "hint": "Pixiv app-api 不返回点赞字段，该项通常无效（插件会告警一次），请改用最小收藏数。", "default": 0},
              "deep_search_depth": {"type": "int", "description": "深度搜索页数；-1 不限", "default": 3},
              "show_details": {"type": "bool", "description": "附带作品详情", "default": true},
              "forward_threshold": {"type": "bool", "description": "使用合并转发发送", "default": false},
              "pixiv_urlsearch_enabled": {"type": "bool", "description": "允许作品链接自动解析", "default": true},
              "ugoira_enabled": {"type": "bool", "description": "启用 Ugoira 转 GIF", "default": true},
              "show_filter_result": {"type": "bool", "description": "显示过滤说明", "default": true},
              "single_response_mode": {"type": "bool", "description": "一次合并发送搜索结果", "default": true},
              "image_quality": {"type": "string", "description": "图片质量", "options": ["original", "large", "medium"], "default": "medium"},
              "image_send_method": {"type": "string", "description": "图片发送方式", "options": ["url", "file", "byte"], "default": "url"},
              "pil_compress_quality": {"type": "int", "description": "本地压缩画质", "default": 100, "slider": {"min": 1, "max": 100, "step": 1}},
              "pil_compress_target_kb": {"type": "int", "description": "本地压缩目标 KB；0 关闭", "default": 0},
              "refresh_token_interval_minutes": {"type": "int", "description": "Token 刷新间隔分钟；0 关闭", "default": 180},
              "subscription_enabled": {"type": "bool", "description": "启用订阅后台任务", "default": true},
              "subscription_force_forward": {"type": "bool", "description": "订阅消息强制合并转发", "default": true},
              "subscription_check_interval_minutes": {"type": "int", "description": "订阅检查间隔分钟", "default": 30},
              "proxy": {"type": "string", "description": "Pixiv HTTP/HTTPS 代理", "default": ""},
              "image_proxy_host": {"type": "string", "description": "Pixiv 图片反代主机", "default": "i.pixiv.re"},
              "use_image_proxy": {"type": "bool", "description": "无代理时使用图片反代", "default": true},
              "api_proxy_host": {"type": "string", "description": "Pixiv API 反代主机", "default": ""},
              "random_search_min_interval": {"type": "int", "description": "随机搜索最短间隔分钟", "default": 60},
              "random_search_max_interval": {"type": "int", "description": "随机搜索最长间隔分钟", "default": 120},
              "random_sent_illust_retention_days": {"type": "int", "description": "随机搜索去重保留天数", "default": 7},
              "search_autocomplete_enabled": {"type": "bool", "description": "启用关键词标签归一化", "hint": "用 Pixiv search_autocomplete 把中文 / 英文关键词换成官方日文 tag；关闭后中文命中率明显下降。网络失败会自动退回旧行为。", "default": true},
              "search_autocomplete_limit": {"type": "int", "description": "最多采纳几个归一化候选 tag", "hint": "调太大容易引入无关 tag，反而拉低精准度。", "default": 3, "slider": {"min": 1, "max": 8, "step": 1}},
              "search_exact_first_enabled": {"type": "bool", "description": "优先精确匹配标签", "hint": "先用 exact_match_for_tags 精准命中，候选不足时才自动降级到部分匹配。", "default": true},
              "search_title_caption_fallback": {"type": "bool", "description": "兜底搜索标题与简介", "hint": "前几级都搜不到时改搜 title_and_caption；结果更杂，但能救冷门关键词。", "default": true},
              "search_prefer_popular": {"type": "bool", "description": "搜索默认按热度排序", "hint": "使用 sort=popular_desc。非 Premium 账号会被 Pixiv 静默降级，插件已自动检测并本地按收藏数重排。", "default": true},
              "search_plan_max_steps": {"type": "int", "description": "一次搜索最多执行几级计划", "hint": "越大越慢；被截断时始终保留兼容旧行为的部分匹配那一级。", "default": 4, "slider": {"min": 1, "max": 6, "step": 1}},
              "search_plan_min_results": {"type": "int", "description": "提前终止所需的候选数", "hint": "候选数达到该值就不再执行后续级别。调大更精准但更耗时。", "default": 10, "slider": {"min": 1, "max": 60, "step": 1}}
            }
          }
        }
      },
      "soutu": {
        "type": "object",
        "description": "搜图神器来源",
        "hint": "抓取 soutushenqi.com，候选不足时可用 Bing 补齐。需要 Playwright Chromium。",
        "items": {
          "enabled": {"type": "bool", "description": "启用搜图神器来源", "default": true},
          "primary_source_enabled": {"type": "bool", "description": "启用 soutushenqi.com 主图源", "default": true},
          "bing_fallback_enabled": {"type": "bool", "description": "启用 Bing 候选补充", "default": true},
          "vlm_selection_enabled": {"type": "bool", "description": "允许视觉模型从候选中挑图", "default": true},
          "vlm_provider_id": {"type": "string", "description": "搜图神器审核模型", "_special": "select_provider", "default": ""},
          "batch_size": {"type": "int", "description": "候选高清图数量", "default": 9, "slider": {"min": 1, "max": 16, "step": 1}},
          "review_rounds": {"type": "int", "description": "视觉筛选最多轮数", "hint": "每轮审核一批候选；当前批全部不匹配时继续检查后续候选。", "default": 3, "slider": {"min": 1, "max": 6, "step": 1}},
          "min_resolution": {"type": "int", "description": "候选最小边像素", "default": 500, "slider": {"min": 100, "max": 4000, "step": 100}}
        }
      },
      "serpapi": {
        "type": "object",
        "description": "SerpApi 文字搜图来源",
        "hint": "只整合上游的文字搜图：Google Images 候选加视觉淘汰赛。",
        "items": {
          "enabled": {"type": "bool", "description": "启用 SerpApi 文字搜图", "default": true},
          "serpapi_keys": {"type": "list", "description": "SerpApi Keys", "hint": "支持多个 Key 轮询。", "default": []},
          "vlm_selection_enabled": {"type": "bool", "description": "启用 SerpApi 视觉淘汰赛", "default": true},
          "vlm_provider_id": {"type": "string", "description": "SerpApi 选图模型", "_special": "select_provider", "default": ""},
          "batch_size": {"type": "int", "description": "每轮拼图候选数", "default": 16, "slider": {"min": 2, "max": 64, "step": 1}},
          "scrape_count": {"type": "int", "description": "搜索候选数量", "default": 16, "slider": {"min": 1, "max": 200, "step": 1}},
          "gl": {"type": "string", "description": "搜索地区代码", "default": "us"},
          "hl": {"type": "string", "description": "搜索界面语言", "default": "zh-cn"},
          "proxy_url": {"type": "string", "description": "SerpApi 代理 URL", "default": ""},
          "user_agent": {"type": "string", "description": "图片下载 User-Agent", "default": ""}
        }
      }
    }
  },
  "reverse_image": {
    "type": "object",
    "description": "以图搜图模块",
    "hint": "支持 SauceNAO、Google Lens、Ascii2d、Yandex，保留附图、回复图和等待下一张图的指令交互。",
    "items": {
      "enabled": {"type": "bool", "description": "启用以图搜图模块", "default": true},
